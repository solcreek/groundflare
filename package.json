{
  "name": "groundflare-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for the groundflare CLI and create-groundflare-app scaffold.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solcreek/groundflare.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:bun": "npm run test:bun -w groundflare",
    "test:e2e": "npm run test:e2e -w groundflare",
    "build": "npm run build -w groundflare-estimate && npm run build -w groundflare && npm run build -w create-groundflare-app"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
